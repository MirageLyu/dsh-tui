{
	"name": "@miragelyu/pi-tui",
	"version": "0.80.7",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications — fork with the dsh-tui editor prompt patch applied (setPrompt, frame, fixed-width prompt prefixes)",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/darwin/prebuilds/**/*.node",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MirageLyu/dsh-tui.git",
		"directory": "vendor/pi-tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
